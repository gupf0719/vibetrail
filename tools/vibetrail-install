#!/bin/bash
# vibetrail 接入脚本。幂等，可反复跑。
#
# 装进**有效 hooks 目录**而不是 `.githooks/` + 改 core.hooksPath，因为：
#   1. core.hooksPath 可能已被别人占用（实测 agentDock 的 worktree 工具就在每个
#      config.worktree 里写绝对路径），我们再设会被覆盖，且**失败是静默的**；
#   2. 有效目录在主仓与全部 worktree 之间共享，装一次全覆盖（实测）。
# 代价：`.git/hooks` 不入仓，所以**每个 clone 都要跑一次本脚本**（git 出于安全
# 不允许仓库自动装 hook，这一步无法省掉——见 README 的搭车建议）。
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SRC="$SELF_DIR/prepare-commit-msg"
[ -f "$SRC" ] || { echo "✗ 找不到 $SRC" >&2; exit 1; }

HOOKS=$(git rev-parse --git-path hooks)
mkdir -p "$HOOKS"
DST="$HOOKS/prepare-commit-msg"

if [ -e "$DST" ] && ! cmp -s "$SRC" "$DST"; then
    echo "✗ $DST 已存在且内容不同。" >&2
    echo "  它可能是别的工具装的。请人工合并后再跑，或先备份删除。" >&2
    exit 1
fi
cp "$SRC" "$DST"; chmod +x "$DST"
echo "✓ hook → $DST"

# 只对 audits/ 用 union：审计记录是追加式流，两个分支各追加一行、union 逐行取并集正好是对的。
# sessions/ 是整份重生成的投影，union 会静默合出两条 end、at 乱序（.gitattributes 里有注释，
# T11 钉着）。旧版这里写的是 `**/*.jsonl`，每次装机都把 sessions/ 一起圈进去，与它上面那条
# 注释自相矛盾，而 doctor 只 grep 'merge=union'，宽窄都算 ✓ —— 所以装机时顺手把旧的宽规则
# 删掉再补窄的，而不是再追加一条（T15–T17）。
GA=.gitattributes
LINE='.claude/trace/audits/*.jsonl merge=union'
BROAD='^[[:space:]]*\.claude/trace/\*\*/\*\.jsonl[[:space:]]+merge=union[[:space:]]*$'
NARROW='^[[:space:]]*\.claude/trace/audits/\*\.jsonl[[:space:]]+merge=union[[:space:]]*$'
if [ -f "$GA" ] && grep -qE "$BROAD" "$GA"; then
    grep -vE "$BROAD" "$GA" > "$GA.tmp" || true; mv "$GA.tmp" "$GA"
    echo "✓ .gitattributes 旧的宽规则 **/*.jsonl 已删（它把 sessions/ 也圈进了 union）"
fi
if [ -f "$GA" ] && grep -qE "$NARROW" "$GA"; then
    echo "✓ .gitattributes 已有 audits/ 的 merge=union"
else
    [ -f "$GA" ] && [ -n "$(tail -c1 "$GA")" ] && echo >> "$GA"
    echo "$LINE" >> "$GA"
    echo "✓ .gitattributes 追加 audits/ 的 merge=union（记得提交它）"
fi

mkdir -p .claude/trace/sessions .claude/trace/audits
echo "✓ .claude/trace/ 就绪"

# vendor 运行时进被观测仓。理由：Stop hook 这类**强制闸门**若依赖一个没克隆的外部仓，
# 会 fail open —— 比没有闸门更糟。vendor 后仓库自给自足。
# 版本漂移由 doctor 校验（同 hook 的做法），不靠人记得同步。
VD=.claude/vibetrail; mkdir -p "$VD"
VT_FILES="vibetrail vibetrail-audit vibetrail-sync vibetrail-doctor vibetrail-install prepare-commit-msg extract-diverge.jq"
for f in $VT_FILES; do
    [ -f "$SELF_DIR/$f" ] || continue
    cp "$SELF_DIR/$f" "$VD/$f"
    case "$f" in *.jq) ;; *) chmod +x "$VD/$f";; esac
done

# 校验清单：装机时记下哈希与可执行位，doctor 据此独立验证。
# 不能靠「跟上游目录比」—— 被观测仓里通常没有上游，而 doctor 以 vendored 副本
# 身份运行时 SELF_DIR 就等于 VD，那是拿文件跟自己比，恒真。
sha(){ if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}';
       else shasum -a 256 "$1" | awk '{print $1}'; fi; }
: > "$VD/MANIFEST"
for f in $VT_FILES; do
    [ -f "$VD/$f" ] || continue
    x=-; [ -x "$VD/$f" ] && x=x
    printf '%s %s %s\n' "$(sha "$VD/$f")" "$x" "$f" >> "$VD/MANIFEST"
done
echo "✓ 运行时 → $VD/（$(wc -l < "$VD/MANIFEST" | tr -d ' ') 个文件 + MANIFEST，记得提交）"
echo
echo "自检：bash $SELF_DIR/vibetrail-doctor"
