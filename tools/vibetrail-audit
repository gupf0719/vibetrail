#!/bin/bash
# 审计过程留痕。这是本项目唯一没有先例可抄的部分——业内所有工具审的是**代码**，
# 没人审**审计过程**（git-ai / SpecStory / Memento 都不记）。
#
# 它替代的是「0 字节 marker」：只记「审过了」，不记「审了什么、报了几个、几真几假」，
# 于是命中率这类数字只能人肉从对话里数，而对话会被压缩掉。
#
# 锚用 patch-id 不用 sha —— sha 在 rebase 后就变（实测本仓 294 个旧 marker 已有 4 个失效）。
set -uo pipefail
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$(git rev-parse --show-toplevel)" || exit 1
OUT=.claude/trace/audits

# 与 spec §4 逐字一致的锚。--cc 让有冲突解决的 merge 也有锚；普通与根 commit 结果不变。
anchor(){
    # 返回 0 = 算出来了（值在 stdout）；非 0 = 算不出来。两者必须分开：
    # 命令替换 $(anchor …) 会丢掉退出码，只看 stdout 的话，任何让管道输出为空的
    # 故障（缺 awk、git 报错、对象不可读）都会退化成「空锚」，而空锚曾被当作放行
    # —— 故障静默变成通过。pipefail 要在子 shell 内显式开，外层的管不到 $() 里面。
    local out st np
    np=$(git rev-list --parents -n1 "$1" 2>/dev/null | wc -w | tr -d ' ')   # 1 + 父数
    if [ "${np:-0}" -gt 2 ] 2>/dev/null; then
        # merge：git patch-id 的输入契约里没有 combined diff——它认的 hunk 头是
        # @@ ... @@，而 --cc 出的是 @@@ ... @@@，匹配不上就当 patch 结束，于是只把
        # 文件头三行喂进了哈希。结果锚 = f(首个冲突文件路径)，与冲突解决内容无关：
        # 实测两个内容毫不相干的解决算出同一个值。改直接哈希 combined diff 正文。
        # 代价：merge 的锚不抗 rebase——但冲突解决本来就不抗（重解出的 patch 真的不同）。
        local body
        body=$(git diff-tree -p --cc --no-commit-id --root "$1" 2>/dev/null) || return 1
        # 无冲突的 merge：combined diff 为空，哈希会是个常量——那不是锚，是「没有锚」
        [ -z "$body" ] && { printf ''; return 0; }
        out=$(set -o pipefail
              printf '%s' "$body" \
                | { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; } \
                | awk '{print $1}' 2>/dev/null); st=$?
        [ $st -ne 0 ] && return 1
    else
        out=$(set -o pipefail
              git diff-tree -p --root "$1" 2>/dev/null \
                | git patch-id --stable 2>/dev/null \
                | awk 'NR==1{print $1}' 2>/dev/null); st=$?
        [ $st -ne 0 ] && return 1
    fi
    printf '%s' "$out"
    return 0
}

cmd_record(){
    local sha kind; sha=$(git rev-parse "${1:-HEAD}") || exit 1; kind=${2:-audit}
    local pid
    pid=$(anchor "$sha") || { echo "✗ 锚算不出来（git / patch-id / awk 有问题），未写记录" >&2; exit 1; }
    if [ -z "$pid" ]; then
        echo "✓ 锚为空（无冲突 merge / 空 commit）—— 按 spec §4.0 无需审计，未写记录"
        return 0
    fi
    local body; body=$(cat)                       # findings JSON 从 stdin 读
    # 空输入必须显式拦：jq -e . 对空输入返回 0（把「没有输入」当成功），
    # 于是空 stdin 一路走到底、写出 0 字节、还打印 ✓。这是那条死循环的根因。
    [ -z "$body" ] && {
        echo "✗ 没有收到 findings。二选一：" >&2
        echo "    …… | $(basename "$0") record $sha $kind    # 管进 findings JSON" >&2
        echo "    mark-audit.sh $kind --none                  # 显式声明本次没找到" >&2
        exit 1; }
    printf '%s' "$body" | jq -e . >/dev/null 2>&1 || { echo "✗ stdin 不是合法 JSON" >&2; exit 1; }
    mkdir -p "$OUT"
    local rec
    rec=$(printf '%s' "$body" | jq -c \
        --arg pid "$pid" --arg kind "$kind" --arg sha "$sha" \
        --arg subj "$(git log -1 --format=%s "$sha")" \
        --arg sid "${CLAUDE_CODE_SESSION_ID:-}" \
        --arg at "$(date -u +%FT%TZ)" '
        {t:"audit", v:1, patchId:$pid, kind:$kind,
         sessionId:(if $sid=="" then null else $sid end),
         at:$at, shaAtTime:$sha, subject:$subj,
         agents:(.agents // []), findings:(.findings // [])}')
    # 先在内存里成形并验非空，再落盘：直接 >> 会让 shell 在 jq 无输出时
    # 照样建出一个 0 字节文件，而那个文件看着像「记录存在」。
    [ -z "$rec" ] && { echo "✗ 记录未能生成，未写盘" >&2; exit 1; }
    printf '%s\n' "$rec" >> "$OUT/$pid.jsonl"
    local n; n=$(printf '%s' "$rec" | jq '(.findings // [])|length')
    # 回显以实际写入为准，不是无条件打印 —— 之前写 0 字节也照样报 ✓
    echo "✓ $kind 记录 → $OUT/${pid:0:12}….jsonl（finding $n 条，本文件累计 $(wc -l < "$OUT/$pid.jsonl" | tr -d ' ') 条）"
}

cmd_show(){
    local sha; sha=$(git rev-parse "${1:-HEAD}") || exit 1
    local pid; pid=$(anchor "$sha")
    [ -z "$pid" ] && { echo "  锚为空 —— 无需审计"; return 0; }
    local f="$OUT/$pid.jsonl"
    [ -f "$f" ] || { echo "  无审计记录（patchId ${pid:0:12}…）"; return 0; }
    jq -rc '"── \(.kind)  \(.at)  by \(.sessionId // "?" | .[0:8])…",
            "   agents: \([.agents[]? | "\(.perspective // .type)(\(.findings // 0))"] | join(", "))",
            (.findings[]? | "   [\(.severity // "?")] \(.verdict // "?")  \(.claim // "")")' "$f"
}

# 命中率这类数字**算出来**，不是从对话里人肉数——这正是断链二要解决的
cmd_stats(){
    [ -d "$OUT" ] || { echo "  无审计记录"; return 0; }
    # jq 的对象键若含非 ASCII 必须加引号，取值也要用 .["…"]；不加是编译错不是运行错。
    cat "$OUT"/*.jsonl 2>/dev/null | jq -s '
      ([.[].findings[]?] | length) as $tot
      | ([.[].findings[]? | select(.verdict=="confirmed")] | length) as $ok
      | { "审计次数": length,
          "覆盖 commit 数": ([.[].patchId] | unique | length),
          "finding 总数": $tot,
          "按判定": ([.[].findings[]?.verdict // "未判定"] | group_by(.) | map({(.[0]): length}) | add),
          "按严重度": ([.[].findings[]?.severity // "未标"] | group_by(.) | map({(.[0]): length}) | add),
          "命中率": (if $tot > 0 then (($ok * 100 / $tot) | floor | tostring) + "%" else "n/a" end) }' 
}

# 专供闸门（Stop hook 等）调用：退出码即答案，锚的判据不需要在调用方复制一份。
# 0 = 该 kind 的记录已存在，或锚为空（无需审计）；1 = 缺记录
cmd_check(){
    local sha kind; sha=$(git rev-parse "${1:-HEAD}" 2>/dev/null) || return 1; kind=${2:-audit}
    local pid
    pid=$(anchor "$sha") || return 1             # 算不出来 ⇒ 不放行
    [ -z "$pid" ] && return 1                    # 空锚 ⇒ 不放行。合法空锚（干净 merge /
                                                 # 空 commit）在闸门层已早退，到不了这里；
                                                 # 能走到这儿的空锚只可能来自故障。
    local f="$OUT/$pid.jsonl"
    [ -f "$f" ] || return 1
    jq -e --arg k "$kind" -s 'any(.[]; .kind == $k)' "$f" >/dev/null 2>&1
}

case "${1:-}" in
    anchor) shift; a=$(anchor "${1:-HEAD}") || exit 1; printf '%s\n' "$a"; exit 0;;
    check)  shift; cmd_check "${1:-HEAD}" "${2:-audit}"; exit $?;;
    record) shift; cmd_record "${1:-HEAD}" "${2:-audit}";;
    show)   shift; cmd_show "${1:-HEAD}";;
    stats)  shift; cmd_stats;;
    *) cat <<'H'
vibetrail-audit —— 审计过程留痕（替代 0 字节 marker）

  vibetrail-audit record [<ref>] [<kind>] < findings.json
        kind: audit（默认）/ crossverify / commentaudit
        stdin: {"agents":[{"type":..,"perspective":..,"findings":N}],
                "findings":[{"id":..,"severity":"HIGH|MED|LOW","claim":..,
                             "verdict":"confirmed|false-positive","why":..,
                             "location":{"uri":..,"line":..},"fix":..}]}
  vibetrail-audit show   [<ref>]     看某个 commit 的审计记录
  vibetrail-audit stats              命中率等，从记录算出来
  vibetrail-audit check  [<ref>] [<kind>]   闸门用：退出码 0=已审 / 1=缺记录

  severity → SARIF level 的映射（将来要导出是机械转换）：HIGH→error / MED→warning / LOW→note
H
    ;;
esac
