#!/bin/sh
# vibetrail hook 的包装（DESIGN D12）：settings.json 里挂的就是这个文件。
# 只做一件事——找到 node，把 stdin 原样转给 vibetrail.mjs。找不到 node 也 exit 0，只往 errors.log 记一行：
# hook 的纪律是永远不打扰人（DESIGN §3.4）。node 的绝对路径记在 ~/.vibetrail/config 的 node=，
# 升级 node 只需重跑 vibetrail init，不用改 settings。
# 与别的入口脚本一致：解析一律按 C locale（bash 3.2 的变量名坑，见 vibetrail 头部）
export LC_ALL=C
SELF=$(cd "$(dirname "$0")" && pwd)
VT_HOME=${VIBETRAIL_HOME:-$HOME/.vibetrail}
NODE=$(sed -n 's/^node=//p' "$VT_HOME/config" 2>/dev/null | tail -1)
[ -n "$NODE" ] && [ -x "$NODE" ] || NODE=$(command -v node 2>/dev/null)
if [ -z "$NODE" ]; then
    mkdir -p "$VT_HOME/logs" 2>/dev/null
    printf '{"time":"%s","event":"%s","session_id":"","stage":"missing_node","rc":127}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${1:-}" >> "$VT_HOME/logs/errors.log" 2>/dev/null
    exit 0
fi
exec "$NODE" "$SELF/vibetrail.mjs" hook "$@"
