#!/bin/sh
# vibetrail-map 的包装（DESIGN D12）：老的 bash+jq 版归档在 old/jq/vibetrail-map，这里转给 node。
# 参数与它完全一致，测试与外部调用不用改。
export LC_ALL=C
SELF=$(cd "$(dirname "$0")" && pwd)
VT_HOME=${VIBETRAIL_HOME:-$HOME/.vibetrail}
NODE=$(sed -n 's/^node=//p' "$VT_HOME/config" 2>/dev/null | tail -1)
[ -n "$NODE" ] && [ -x "$NODE" ] || NODE=$(command -v node 2>/dev/null)
[ -n "$NODE" ] || { printf '✗ vibetrail-map: 没找到 node\n' >&2; exit 1; }
exec "$NODE" "$SELF/vibetrail.mjs" map-file "$@"
