#!/bin/bash
# vibetrail-map：把一份 transcript 映射成 paas-coding-hook 协议 1.0 事件（分歧一路），逐行输出到 stdout。
#
# 用法：vibetrail-map <transcript.jsonl> [--sid ID] [--from-line N] [--project-id X] [--workspace-id Y]
#                     [--meta meta.json] [--ledger FILE] [--vt-version V]
#   --sid          会话 id；默认从路径推：主会话 = 文件名去 .jsonl，子 agent 文件（…/<sid>/subagents/agent-*.jsonl）= 上两级目录名
#   --from-line N  只对行号 > N 的触发记录发事件（增量；索引照建）。默认 0 = 全文
#   --project-id / --workspace-id  协议的两个必填 id；默认都取 transcript 第一条带 cwd 记录的 cwd（hook 分发入口会传真值）
#   --meta         子 agent 的 meta.json（agentType / toolUseId）；默认取同名 .meta.json（有就用）
#   --ledger FILE  账本写到文件（默认写 stderr）：进出条数、反查方式、消费到的行号与字节数（供 manifest 记 offset）
#
# 只读 transcript，不写任何东西到它旁边；产物只有 stdout 与账本。只解析到源文件最后一个换行符（源可能正在写半行）。
# event_id = UUIDv5(vibetrail 命名空间, "<sid>|<记录 uuid>|<事件类型>|<限定符>")，同一输入重跑得到同一个 id（幂等重发靠它）。
set -uo pipefail
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
: "${JQ:=jq}"

die(){ echo "✗ vibetrail-map: $*" >&2; exit 2; }

f=""; sid=""; from_line=0; project_id=""; workspace_id=""; meta=""; ledger=""; vt_version="0.2.0-dev"
while [ $# -gt 0 ]; do
    case "$1" in
        --sid) sid=$2; shift 2;;
        --from-line) from_line=$2; shift 2;;
        --project-id) project_id=$2; shift 2;;
        --workspace-id) workspace_id=$2; shift 2;;
        --meta) meta=$2; shift 2;;
        --ledger) ledger=$2; shift 2;;
        --vt-version) vt_version=$2; shift 2;;
        -h|--help) sed -n '2,15p' "$0"; exit 0;;
        -*) die "未知参数 $1";;
        *) [ -n "$f" ] && die "只接受一个 transcript"; f=$1; shift;;
    esac
done
[ -n "$f" ] || die "缺 transcript 路径"
[ -f "$f" ] || die "文件不存在: $f"
case "$from_line" in ''|*[!0-9]*) die "--from-line 要是非负整数";; esac

# ---- sid / meta：从路径推 ----
base=$(basename "$f" .jsonl)
if [ -z "$sid" ]; then
    case "$f" in
        */subagents/*) sid=$(basename "$(dirname "$(dirname "$f")")");;
        *) sid=$base;;
    esac
fi
[ -z "$meta" ] && [ -f "${f%.jsonl}.meta.json" ] && meta="${f%.jsonl}.meta.json"
meta_json=null
if [ -n "$meta" ]; then
    meta_json=$($JQ -c 'if type == "object" then . else null end' "$meta" 2>/dev/null) || die "meta 不是 JSON: $meta"
fi

# ---- project_id / workspace_id 默认值 ----
if [ -z "$project_id" ] || [ -z "$workspace_id" ]; then
    cwd=$($JQ -r 'select(type == "object" and (.cwd | type) == "string") | .cwd' "$f" 2>/dev/null | head -1)
    [ -z "$cwd" ] && cwd="unknown"
    [ -z "$project_id" ] && project_id=$cwd
    [ -z "$workspace_id" ] && workspace_id=$cwd
fi

# ---- 只读到最后一个换行符 ----
total=$(wc -c < "$f" | tr -d ' ')
consumed=$total
tmp=$(mktemp "${TMPDIR:-/tmp}/vibetrail-map.XXXXXX") || die "mktemp 失败"
trap 'rm -f "$tmp" "$tmp.ids" "$tmp.raw"' EXIT
if [ "$total" -gt 0 ] && [ "$(tail -c1 "$f" | od -An -tx1 | tr -d ' \n')" != "0a" ]; then
    partial=$(tail -n1 "$f" | wc -c | tr -d ' ')
    consumed=$((total - partial))
fi
head -c "$consumed" "$f" > "$tmp.raw"

# ---- 映射 ----
$JQ -n -c -L "$SELF" \
    --arg sid "$sid" --arg project_id "$project_id" --arg workspace_id "$workspace_id" \
    --argjson from_line "$from_line" --argjson meta "$meta_json" \
    --arg vt_version "$vt_version" --arg rule_version "diverge-v1" \
    -f "$SELF/map-events.jq" < "$tmp.raw" > "$tmp" 2>"$tmp.err"
rc=$?
if [ $rc -ne 0 ] || [ -s "$tmp.err" ]; then
    echo "✗ vibetrail-map: jq 失败（rc=$rc）: $(head -c 300 "$tmp.err")" >&2; rm -f "$tmp.err"; exit 1
fi
rm -f "$tmp.err"

# ---- event_id：UUIDv5 ----
# 命名空间 = uuid5(NS_URL, "vibetrail")，固定值；名字 = "<sid>|<_key>"。SHA-1 用 shasum（macOS）或 sha1sum（Linux）。
NS=e292a4eb-2f64-58fd-97d9-bb9491e5359d
if command -v shasum >/dev/null 2>&1; then sha1(){ shasum -a 1 | cut -c1-40; }
elif command -v sha1sum >/dev/null 2>&1; then sha1(){ sha1sum | cut -c1-40; }
else die "缺 shasum / sha1sum"; fi
NSB=$(printf '%s' "$NS" | tr -d '-' | sed 's/../\\x&/g')
uuid5(){ # uuid5 <name>
    local h; h=$( { printf "$NSB"; printf '%s' "$1"; } | sha1 )
    printf '%s-%s-5%s-%x%s-%s' "${h:0:8}" "${h:8:4}" "${h:13:3}" $(( (0x${h:16:1} & 0x3) | 0x8 )) "${h:17:3}" "${h:20:12}"
}
: > "$tmp.ids"
$JQ -r 'select(._key != null) | ._key' "$tmp" | while IFS= read -r key; do
    printf '%s\t%s\n' "$key" "$(uuid5 "$sid|$key")" >> "$tmp.ids"
done
# ids 表 → JSON 对象 {key: uuid}；再一次 jq 把 event_id 填上、删 _key。key 唯一性在这里就查
dups=$(cut -f1 "$tmp.ids" | sort | uniq -d | head -3)
[ -n "$dups" ] && die "事件 _key 重复（同一记录派生了两条同型事件）: $dups"
$JQ -R -s -c 'split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: .[1]}) | from_entries' "$tmp.ids" > "$tmp.ids.json"
trap 'rm -f "$tmp" "$tmp.ids" "$tmp.ids.json" "$tmp.raw"' EXIT

$JQ -c --slurpfile ids "$tmp.ids.json" \
    'select(._ledger == null) | .event_id = $ids[0][._key] | del(._key)' "$tmp"

# ---- 账本 ----
lg=$($JQ -c --arg f "$f" --arg sid "$sid" --argjson consumed "$consumed" --argjson total "$total" \
        'select(._ledger != null) | ._ledger + {file: $f, sid: $sid, consumed_bytes: $consumed, file_bytes: $total}' "$tmp")
if [ -n "$ledger" ]; then printf '%s\n' "$lg" > "$ledger"; else printf '%s\n' "$lg" >&2; fi
