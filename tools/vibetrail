#!/bin/bash
# vibetrail：机器级安装、登记与本地查看（DESIGN §5；G8 / G9）。
#
#   vibetrail init [--scope project|user] [--no-register] [--no-pick] [--events auto|core|all]
#       机器级装一次：运行时拷到 ~/.vibetrail/bin/，~/.claude/settings.json 里写 hook 条目（命令里带 vibetrail-hook，升级按它换掉旧条目），
#       写 ~/.vibetrail/config（scope、jq 绝对路径、device_id…）。在 git 仓里跑且 scope=project 时顺手登记本仓（worktree 共享）；
#       在终端里跑还会列出用过 Claude Code 的仓让人选（--no-pick 不问），最后列出登记表——scope=project 只采登记过的仓。
#       被观测仓里什么都不写（A8）。可以反复跑：升级运行时、刷新条目，已有的配置与登记不动。
#       --events：auto（默认）只登记本机每个 Claude Code 都认识的 hook 事件——settings 里有它不认识的事件名，
#                 它会把整份 settings 判为出错并整个跳过（2.1.266 二进制里的提示原文：Files with errors are skipped entirely）；
#                 core 只登记老版本也有的 6 个；all 全部登记
#   vibetrail uninstall [--purge]
#       去掉 settings 里的 vibetrail 条目，删 ~/.vibetrail/bin、state、logs；spool（还没发出去的数据）、config、登记表留着，
#       --purge 才连 ~/.vibetrail 整个删掉（A7）
#   vibetrail projects [list | add [目录] | remove [目录] | pick]     scope=project 时的登记表（U2）；pick 从用过 Claude Code 的仓里选
#   vibetrail list                                            本机 spool 里有哪些块：项目、会话、条数、大小（就是将来 push 的内容）
#   vibetrail show [--session SID] [--type 前缀] [--last N] [--json]
#       把采到的事件按会话、按时间列成人能读的一行一条；--json 原样输出协议事件
#   vibetrail sync                                            立刻把登记过的仓里没采完的 transcript 补一遍（平时开会话时的 SessionStart 会做）
#   vibetrail doctor                                          自检：运行时、jq、settings 条目、scope 与登记、采集证据、落后、错误日志
#   vibetrail version
#
# 环境变量：VIBETRAIL_HOME（默认 ~/.vibetrail）、VIBETRAIL_CLAUDE_SETTINGS（默认 ${CLAUDE_CONFIG_DIR:-~/.claude}/settings.json）、
#   VIBETRAIL_CLAUDE_PROJECTS（默认 ${CLAUDE_CONFIG_DIR:-~/.claude}/projects）、VIBETRAIL_CLAUDE_BINARIES（冒号分隔，覆盖自动找到的 Claude Code 可执行文件）
# 固定 C locale：macOS 自带的 bash 3.2 在 UTF-8 locale 下会把紧跟在变量名后的中文字符首字节算进变量名（变量名后紧跟「）」时，bash 找的是「V 加上「）」的首字节」这个变量），
# 开了 set -u 就报 unbound variable（用户 09-15 的终端踩到），没开就悄悄展开成空；tr / sort 的结果也随 locale 变。放在最前面，后面的解析都按 C
export LC_ALL=C
set -uo pipefail
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "$SELF/vibetrail-lib.sh"

RUNTIME_FILES="vibetrail vibetrail-hook vibetrail-lib.sh vibetrail-map map-events.jq diverge-rules.jq hook-events.jq"
CORE_EVENTS="SessionStart UserPromptSubmit Stop SubagentStop SessionEnd Notification"     # 老版本就有
OPT_EVENTS="SubagentStart PostToolUseFailure PermissionRequest PermissionDenied StopFailure InstructionsLoaded CwdChanged"
SETTINGS=$(vt_settings_path)

say(){ printf '%s\n' "$*"; }
die(){ printf '✗ %s\n' "$*" >&2; exit 1; }
usage(){ sed -n '2,25p' "$SELF/vibetrail" | sed 's/^# \{0,1\}//'; }

find_jq(){ # jq 的绝对路径：config 里记的优先，其次 PATH；hook 不靠 PATH（desktop 启动的 hook 拿到什么 PATH 未测，§3.4）
    local j; j=$(vt_conf jq "")
    if [ -z "$j" ] || [ ! -x "$j" ]; then j=$(command -v jq 2>/dev/null) || return 1; fi
    ( cd "$(dirname "$j")" && printf '%s/%s' "$(pwd -P)" "$(basename "$j")" )
}

conf_set(){ # conf_set <key> <value>：改或加一行，别的行原样留着
    mkdir -p "$VT_HOME"; touch "$VT_HOME/config"
    { grep -v "^$1=" "$VT_HOME/config"; printf '%s=%s\n' "$1" "$2"; } > "$VT_HOME/config.tmp" && mv "$VT_HOME/config.tmp" "$VT_HOME/config"
}

new_uuid(){ # 随机 UUIDv4（device_id 用）
    if command -v uuidgen >/dev/null 2>&1; then uuidgen | tr 'A-Z' 'a-z'
    elif [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
    else od -An -N16 -tx1 /dev/urandom | tr -d ' \n' | sed -E 's/^(.{8})(.{4}).(.{3}).(.{3})(.{12}).*/\1-\2-4\3-a\4-\5/'; fi
}

claude_binaries(){ # 本机的 Claude Code 可执行文件（desktop 自带的每个版本、PATH 里的 claude、本地安装），一行一个
    if [ -n "${VIBETRAIL_CLAUDE_BINARIES:-}" ]; then printf '%s\n' "$VIBETRAIL_CLAUDE_BINARIES" | tr ':' '\n' | grep -v '^$'; return; fi
    local c r
    for c in "$HOME/Library/Application Support/Claude/claude-code"/*/claude.app/Contents/MacOS/claude \
             "$HOME/.claude/local/node_modules/@anthropic-ai/claude-code/cli.js" "$HOME/.local/share/claude/versions"/*; do
        [ -f "$c" ] && printf '%s\n' "$c"
    done
    c=$(command -v claude 2>/dev/null) || return 0
    r=$c; while [ -L "$r" ]; do r=$(cd "$(dirname "$r")" && cd "$(dirname "$(readlink "$r")")" && pwd -P)/$(basename "$(readlink "$r")"); done
    [ -f "$r" ] && printf '%s\n' "$r"
}

known_events_of(){ # known_events_of <可执行文件> → 它认识的 hook 事件名（首尾各带一个空格，便于 case 匹配）；认不出输出空
    # settings 的 hooks 按一个事件名数组校验（2.1.266 里是 ["PreToolUse","PostToolUse",…,"MessageDisplay"]，在 200 MB 二进制的 157 MB 处），
    # 把这个数组抽出来：扫一遍约 1.2 s，所以按「大小:修改时间:路径」缓存在 state/claude-events.cache，版本不变就不再扫
    local f=$1 key lit ev out="" cache="$VT_HOME/state/claude-events.cache"
    key="$(wc -c < "$f" 2>/dev/null | tr -d ' '):$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null):$f"
    if [ -f "$cache" ]; then out=$(awk -F'\t' -v k="$key" '$1 == k { print $2; exit }' "$cache"); [ -n "$out" ] && { printf '%s' "$out"; return; }; fi
    lit=$(LC_ALL=C grep -a -o -m1 '\["PreToolUse","PostToolUse"[^]]*\]' "$f" 2>/dev/null | head -1)
    if [ -n "$lit" ]; then out=" $(printf '%s' "$lit" | tr -d '[]"' | tr ',' ' ') "
    else for ev in $CORE_EVENTS $OPT_EVENTS; do LC_ALL=C grep -a -q -F "\"$ev\"" "$f" 2>/dev/null && out="$out $ev"; done   # 老版本数组形状不同：逐个找
         [ -n "$out" ] && out="$out "; fi
    if [ -n "$out" ]; then mkdir -p "$VT_HOME/state"; { grep -v -F "	$f	" "$cache" 2>/dev/null | grep -v -F ":$f	"; printf '%s\t%s\n' "$key" "$out"; } > "$cache.tmp" 2>/dev/null && mv "$cache.tmp" "$cache"; fi
    printf '%s' "$out"
}

events_for(){ # events_for auto|core|all → 要登记的事件名（空格分隔）：auto = 本机每个 Claude Code 都认识的
    local mode=$1 ev bin ok out=$CORE_EVENTS sets="" k
    case "$mode" in core) printf '%s' "$CORE_EVENTS"; return;; all) printf '%s %s' "$CORE_EVENTS" "$OPT_EVENTS"; return;; esac
    local bins; bins=$(claude_binaries | sort -u)
    [ -n "$bins" ] || { printf '%s' "$CORE_EVENTS"; return; }
    while IFS= read -r bin; do k=$(known_events_of "$bin"); [ -n "$k" ] || k=" $CORE_EVENTS "; sets="$sets$k"$'\n'; done <<< "$bins"
    for ev in $OPT_EVENTS; do
        ok=1
        while IFS= read -r k; do [ -n "$k" ] || continue; case "$k" in *" $ev "*) ;; *) ok=0; break;; esac; done <<< "$sets"
        [ $ok = 1 ] && out="$out $ev"
    done
    printf '%s' "$out"
}

hook_command(){ # 条目里的命令：绝对路径、单引号包住（路径里可能有空格）；bash 显式给，不靠可执行位
    local p="$VT_HOME/bin/vibetrail-hook"
    printf "/bin/bash '%s' %s" "$(printf '%s' "$p" | sed "s/'/'\\\\''/g")" "$1"
}

entries_json(){ # entries_json <事件…> → [{event, group}]：每个事件一个 matcher 组（Notification 两组），timeout 显式给（§3.4）
    local ev out="" t a m ms
    for ev in "$@"; do
        a=false; ms="-"
        case "$ev" in
            SessionStart|UserPromptSubmit) t=10;;           # 同步：hook 自己立刻退出、活在后台做
            SessionEnd) t=5;;
            Stop|SubagentStop) t=120; a=true;;             # 异步：不阻塞、不计 timeout（Stop 要等 stop_hook_summary，首次整读大会话约 12 s）
            Notification) t=30; a=true; ms="permission_prompt idle_prompt";;   # 权限弹窗记事件头；空闲时补一次解析
            *) t=30; a=true;;
        esac
        for m in $ms; do
            [ "$m" = "-" ] && m=""
            out="$out$("$JQ" -n -c --arg ev "$ev" --arg cmd "$(hook_command "$ev")" --argjson t "$t" --argjson a "$a" --arg m "$m" \
                '{event: $ev, group: ((if $m != "" then {matcher: $m} else {} end)
                                     + {hooks: [{type: "command", command: $cmd, timeout: $t} + (if $a then {async: true} else {} end)]})}')"$'\n'
        done
    done
    printf '%s' "$out" | "$JQ" -s -c '.'
}

# settings 里认自家条目：命令里含 vibetrail-hook（升级时整条换掉，照 Pilot 按命令认条目的做法）
JQ_STRIP='def ours: ((.command? // "") | tostring | contains("vibetrail-hook"));
  if (.hooks | type) == "object" then
    .hooks |= (with_entries(.value |= (if type == "array"
        then map(if (type == "object" and (.hooks | type) == "array") then .hooks |= map(select(ours | not)) else . end)
             | map(select((type != "object") or ((.hooks | type) != "array") or ((.hooks | length) > 0)))
        else . end))
      | with_entries(select((.value | type) != "array" or (.value | length) > 0)))
    | if .hooks == {} then del(.hooks) else . end
  else . end'

settings_read(){ # settings_read → stdout 当前 settings（没有文件当 {}）；不是 JSON 对象就报错退出，不动它
    if [ -s "$SETTINGS" ]; then
        "$JQ" -e 'if type == "object" then . else error("settings 不是 JSON 对象") end' "$SETTINGS" 2>/dev/null \
            || die "读不了 ${SETTINGS}（不是合法的 JSON 对象）。先修好它再装，vibetrail 不会去改一份读不懂的 settings"
    else echo '{}'; fi
}

under_tmp(){ # under_tmp <路径>：在临时目录下（${TMPDIR}、/tmp、/private/tmp、/var/folders；测试可用 VIBETRAIL_TMP_ROOTS 冒号分隔覆盖）
    # 原样路径与解析后的路径都比（macOS 上 /var 解析成 /private/var；文件解析它所在的目录）
    local p pr r rr d
    p=$1; d=$(dirname "$1")
    if [ -d "$1" ]; then pr=$(vt_realpath "$1" 2>/dev/null); else pr=$(vt_realpath "$d" 2>/dev/null)/$(basename "$1"); fi
    for r in $(printf '%s' "${VIBETRAIL_TMP_ROOTS:-${TMPDIR:-/tmp}:/tmp:/private/tmp:/var/folders:/private/var/folders}" | tr ':' ' '); do
        r=${r%/}; [ -n "$r" ] || continue
        rr=$(vt_realpath "$r" 2>/dev/null || printf '%s' "$r")
        for x in "$p" "$pr"; do
            case "$x/" in "$r"/*|"$rr"/*) return 0;; esac
        done
    done
    return 1
}

settings_ok(){ # settings_ok：刚写的 settings 是 JSON 对象，vibetrail 的每条 hook 命令指向的脚本都在
    "$JQ" -e 'type == "object"' "$SETTINGS" >/dev/null 2>&1 || return 1
    local c p
    while IFS= read -r c; do
        [ -n "$c" ] || continue
        p=$(printf '%s' "$c" | sed -n "s/^[^']*'\(.*\)' [A-Za-z]*\$/\1/p" | sed "s/'\\\\''/'/g")
        [ -n "$p" ] && [ -f "$p" ] || return 1
    done < <("$JQ" -r '[(.hooks // {})[][]?.hooks[]? | (.command? // "") | tostring | select(contains("vibetrail-hook"))] | .[]' "$SETTINGS" 2>/dev/null)
    return 0
}

settings_same(){ # settings_same <读进来时的内容>：settings 现在与读进来时按 JSON 语义相同（没有文件、空文件都当 {}）
    local now; now=$( { [ -s "$SETTINGS" ] && "$JQ" -S -c . "$SETTINGS" 2>/dev/null; } || echo '{}')
    [ "$now" = "$(printf '%s' "$1" | "$JQ" -S -c .)" ]
}

settings_write(){ # settings_write <读进来时的内容> < 新内容。照 Pilot 的 writeTextFileAtomic（src/utils/fs-utils.ts）：
    # 1. 读进来之后被别人改过（Claude Code、别的会话）就不写，备份前、rename 前各查一次——init 在读与写之间要扫 Claude Code 可执行文件，首次 2 s 多
    # 2. 第一次改之前的原样另存 settings.json.before-vibetrail，永不覆盖、不参与轮换（Pilot 用 COPYFILE_EXCL 只备份一次）；
    #    那时里面已经有 vibetrail 的条目就不算原样，不存。另外每次改之前再存一份带时间的，只留最近 10 份（撤销某一次改动用）
    # 3. 临时文件 + rename
    local expect=$1 new f; new=$(cat)
    mkdir -p "$VT_HOME/backup" "$(dirname "$SETTINGS")"
    settings_same "$expect" || { say "⚠ $SETTINGS 在这期间被改过，没写；再跑一次即可"; return 1; }
    if [ -s "$SETTINGS" ]; then
        f="$VT_HOME/backup/settings.json.before-vibetrail"
        [ -e "$f" ] || grep -q 'vibetrail-hook' "$SETTINGS" || cp -p "$SETTINGS" "$f"
        cp -p "$SETTINGS" "$VT_HOME/backup/settings.json.$(date -u +%Y%m%dT%H%M%SZ)-$$"
        ls -1t "$VT_HOME/backup"/settings.json.2* 2>/dev/null | tail -n +11 | while IFS= read -r f; do rm -f "$f"; done
    fi
    printf '%s\n' "$new" > "$SETTINGS.vibetrail.tmp" || return 1
    settings_same "$expect" || { rm -f "$SETTINGS.vibetrail.tmp"; say "⚠ $SETTINGS 在这期间被改过，没写；再跑一次即可"; return 1; }
    mv "$SETTINGS.vibetrail.tmp" "$SETTINGS"
}

cmd_init(){
    local scope="" register=1 pick=1 mode=auto a
    while [ $# -gt 0 ]; do
        case "$1" in
            --scope) scope=${2:-}; shift 2;;
            --no-register) register=0; shift;;
            --no-pick) pick=0; shift;;
            --events) mode=${2:-}; shift 2;;
            *) die "init 不认识的参数：$1";;
        esac
    done
    case "$scope" in ''|project|user) ;; *) die "--scope 只能是 project 或 user";; esac
    case "$mode" in auto|core|all) ;; *) die "--events 只能是 auto / core / all";; esac
    JQ=$(find_jq) || die "没找到 jq（hook 与映射都靠它；macOS 可以 brew install jq）"; export JQ
    command -v git >/dev/null 2>&1 || die "没找到 git"
    local cur; cur=$(settings_read) || exit 1

    # 1. 运行时
    mkdir -p "$VT_HOME"/spool "$VT_HOME"/state "$VT_HOME"/projects "$VT_HOME"/logs
    if [ "$(vt_realpath "$SELF")" != "$(vt_realpath "$VT_HOME/bin" 2>/dev/null)" ]; then
        rm -rf "$VT_HOME/bin.new"; mkdir -p "$VT_HOME/bin.new"
        for a in $RUNTIME_FILES; do cp "$SELF/$a" "$VT_HOME/bin.new/$a" || die "拷不了 $SELF/$a"; done
        chmod +x "$VT_HOME/bin.new/vibetrail" "$VT_HOME/bin.new/vibetrail-hook" "$VT_HOME/bin.new/vibetrail-map"
        local src_rev; src_rev=$(git -C "$SELF" rev-parse --short HEAD 2>/dev/null || echo unknown)
        printf 'version=%s\nsource=%s\nsource_rev=%s\ninstalled_at=%s\n' "$VT_RUNTIME_VERSION" "$SELF" "$src_rev" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$VT_HOME/bin.new/VERSION"
        ( cd "$VT_HOME/bin.new" && for a in $RUNTIME_FILES; do
              printf '%s %s\n' "$( (command -v sha256sum >/dev/null 2>&1 && sha256sum "$a" || shasum -a 256 "$a") | cut -c1-64)" "$a"
          done > MANIFEST )
        rm -rf "$VT_HOME/bin.old"; [ -d "$VT_HOME/bin" ] && mv "$VT_HOME/bin" "$VT_HOME/bin.old"
        mv "$VT_HOME/bin.new" "$VT_HOME/bin" && rm -rf "$VT_HOME/bin.old"
    fi
    say "✓ 运行时 → $VT_HOME/bin/（$(printf '%s\n' $RUNTIME_FILES | wc -l | tr -d ' ') 个文件，版本 ${VT_RUNTIME_VERSION}）"

    # 2. 配置：已有的值不动，只补缺的；--scope 显式给了才改
    [ -n "$scope" ] && conf_set scope "$scope"
    [ -n "$(vt_conf scope)" ] || conf_set scope project
    conf_set jq "$JQ"
    [ -n "$(vt_conf device_id)" ] || conf_set device_id "$(new_uuid)"
    [ -n "$(vt_conf turn_idle_close)" ] || conf_set turn_idle_close 3600
    [ -n "$(vt_conf push_max_age)" ] || conf_set push_max_age 3600
    [ -n "$(vt_conf push_max_events)" ] || conf_set push_max_events 100
    grep -q '^endpoint=' "$VT_HOME/config" || conf_set endpoint ""
    chmod 600 "$VT_HOME/config"
    say "✓ 配置 → $VT_HOME/config（scope=$(vt_conf scope)，jq=${JQ}）"

    # 3. settings 条目
    local events bins; events=$(events_for "$mode"); bins=$(claude_binaries | sort -u)
    # shellcheck disable=SC2086
    local entries new written=0; entries=$(entries_json $events)
    new=$(printf '%s' "$cur" | "$JQ" --argjson e "$entries" "$JQ_STRIP"' | reduce $e[] as $x (.; .hooks[$x.event] = ((.hooks[$x.event] // []) + [$x.group]))') \
        || die "算不出新的 settings"
    # 与现有的按 JSON 语义相同（重跑 init、版本没变）就不动：不多一份备份，也不把人手写的格式改掉
    if [ "$(printf '%s' "$new" | "$JQ" -S -c .)" = "$(printf '%s' "$cur" | "$JQ" -S -c .)" ]; then
        say "✓ hook 条目已是最新（${SETTINGS} 没动，$(printf '%s\n' $events | wc -l | tr -d ' ') 个事件：${events}）"
    else
        # 运行时在临时目录、settings 却不在：多半是测试或实验只设了 VIBETRAIL_HOME、漏了 VIBETRAIL_CLAUDE_SETTINGS——不写。
        # 09-15 test-hook-flow 第 16 段就这样把用户真实 settings 里的 hook 命令写成了临时目录（用户：「改claude这些配置文件一定要小心」）
        if under_tmp "$VT_HOME" && ! under_tmp "$SETTINGS"; then
            die "VIBETRAIL_HOME（${VT_HOME}）在临时目录里，却要把 hook 命令写进 ${SETTINGS}：多半是测试或实验漏设了 VIBETRAIL_CLAUDE_SETTINGS。没写"
        fi
        local existed=0; [ -s "$SETTINGS" ] && existed=1
        printf '%s\n' "$new" | settings_write "$cur" || die "写不了 $SETTINGS"
        if ! settings_ok; then   # 写完自检：不是合法 JSON，或 hook 命令指向的脚本不在——还原成改之前
            local bk; bk=$(ls -t "$VT_HOME/backup"/settings.json.*-$$ 2>/dev/null | head -1)
            if [ -n "$bk" ]; then cp -p "$bk" "$SETTINGS"; elif [ $existed = 0 ]; then rm -f "$SETTINGS"; fi
            die "写完的 $SETTINGS 自检没过（不是合法 JSON，或 hook 命令指向的脚本不在），已还原成改之前"
        fi
        written=1
        say "✓ hook 条目 → ${SETTINGS}（$(printf '%s\n' $events | wc -l | tr -d ' ') 个事件：${events}）"
    fi
    if [ "$mode" = auto ]; then
        if [ -n "$bins" ]; then say "  按本机 $(printf '%s\n' "$bins" | wc -l | tr -d ' ') 个 Claude Code 可执行文件都认识的事件登记（--events all 可全登记）"
        else say "  ⚠ 没找到 Claude Code 可执行文件，只登记老版本也有的 6 个事件"; fi
    fi
    [ "$written" = 1 ] && say "  改之前的备份在 $VT_HOME/backup/$([ -e "$VT_HOME/backup/settings.json.before-vibetrail" ] && echo "（装之前的原样是 settings.json.before-vibetrail）")；settings 热加载，已开着的会话从下一次 hook 起生效"

    # PermissionRequest 挂上的时刻：之后的 user-rejected 能查这次调用弹没弹过权限框，之前的只能按 permissionMode 粗分（K7）
    if printf '%s\n' $events | grep -qx PermissionRequest; then
        [ -n "$(vt_conf permission_request_since "")" ] || conf_set permission_request_since "$(date +%s)"
    else conf_set permission_request_since ""; fi

    # 4. 登记本仓；在终端里跑还让人从用过 Claude Code 的仓里选（用户 09-15：「默认也是项目级，但是init后好像没选项目」）；最后列出登记表
    if [ "$(vt_conf scope project)" = project ]; then
        if [ $register = 1 ]; then
            local m; m=$(vt_main_checkout "$PWD" 2>/dev/null) && { vt_register "$PWD" && say "✓ 已登记本仓 ${m}（它的所有 worktree 都采）"; } \
                || say "  当前目录不在 git 仓里，没有顺手登记"
        fi
        if [ $pick = 1 ] && [ -t 0 ] && [ -t 1 ]; then say ""; pick_projects; fi
        say ""; show_registered
    else
        say "  scope=user：本机所有目录的会话都采，不看登记表"
    fi
    say ""
    say "看采了什么：$VT_HOME/bin/vibetrail show     文件在 $VT_HOME/spool/<项目>/<会话>/*.jsonl"
    say "自检：$VT_HOME/bin/vibetrail doctor          卸载：$VT_HOME/bin/vibetrail uninstall"
}

cmd_uninstall(){
    local purge=0
    [ "${1:-}" = "--purge" ] && purge=1
    JQ=$(find_jq) || die "没找到 jq，改不了 settings；手动删掉 $SETTINGS 里命令含 vibetrail-hook 的条目"; export JQ
    if [ -f "$SETTINGS" ]; then
        local cur; cur=$(settings_read) || exit 1
        if printf '%s' "$cur" | grep -q 'vibetrail-hook'; then
            printf '%s' "$cur" | "$JQ" "$JQ_STRIP" | settings_write "$cur" || die "写不了 $SETTINGS"
            say "✓ 已从 $SETTINGS 去掉 vibetrail 的 hook 条目（原文件备份在 $VT_HOME/backup/）"
        else say "  $SETTINGS 里没有 vibetrail 的条目"; fi
    fi
    if [ $purge = 1 ]; then
        rm -rf "$VT_HOME"; say "✓ 已删除 ${VT_HOME}（含 spool 里还没发出去的数据）"
    else
        rm -rf "$VT_HOME/bin" "$VT_HOME/state" "$VT_HOME/logs"
        say "✓ 已删除 $VT_HOME/bin、state、logs"
        say "  留着：spool（还没发出去的数据）、config、登记表、settings 备份；连它们一起删用 --purge"
    fi
    say "  被观测的仓里本来就没写过东西，不用还原"
}

candidate_projects(){ # → 每行「最近活跃 epoch<TAB>会话数<TAB>主 checkout」：用过 Claude Code 的 git 仓，按最近活跃排
    # ~/.claude/projects 下每个目录是一个工作目录；取最近那份 transcript 里的 cwd 推出主 checkout，同一个仓的 worktree 并成一项
    local d f cwd m mt n
    for d in "$(vt_claude_projects)"/*/; do
        f=$(ls -t "$d"*.jsonl 2>/dev/null | head -1); [ -n "$f" ] || continue
        cwd=$(grep -m1 -o '"cwd":"[^"]*"' "$f" 2>/dev/null | head -1 | cut -d'"' -f4)
        [ -n "$cwd" ] || continue
        [ -d "$cwd" ] || cwd=${cwd%%/.claude/worktrees/*}   # desktop 的 worktree 删了：<仓>/.claude/worktrees/<名字> 找回主仓
        [ -d "$cwd" ] || continue
        m=$(vt_main_checkout "$cwd" 2>/dev/null) || continue
        mt=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0)
        n=$(ls "$d"*.jsonl 2>/dev/null | wc -l | tr -d ' ')
        printf '%s\t%s\t%s\n' "$mt" "$n" "$m"
    done | awk -F'\t' '{ if (!($3 in last) || $1 > last[$3]) last[$3] = $1; cnt[$3] += $2 } END { for (p in last) printf "%s\t%s\t%s\n", last[p], cnt[p], p }' \
         | sort -t "$(printf '\t')" -k1,1nr
}

fmt_epoch(){ date -r "$1" '+%m-%d %H:%M' 2>/dev/null || date -d "@$1" '+%m-%d %H:%M' 2>/dev/null || echo "?"; }

pick_projects(){ # 列出用过 Claude Code 的仓（✓ = 已登记），读一行编号登记：空格分隔、a 全部、直接回车不改。stdin 不是终端时也照读一行（脚本、测试用）
    local cands i=0 mt n p ans k added=0
    cands=$(candidate_projects)
    if [ -z "$cands" ]; then say "  没在 $(vt_claude_projects) 下找到用过 Claude Code 的 git 仓；在要采的仓里跑 $VT_HOME/bin/vibetrail projects add"; return 0; fi
    say "用过 Claude Code 的仓（按最近活跃排，✓ = 已登记）："
    while IFS="$(printf '\t')" read -r mt n p; do
        i=$((i + 1))
        say "  $(printf '%2d' "$i"). $(vt_registered "$p" && echo '✓' || echo ' ') $p   （${n} 个会话，最近 $(fmt_epoch "$mt")）"
    done <<EOF_CANDS
$cands
EOF_CANDS
    printf '要采哪些？输编号（空格分隔），a 全部，直接回车不改：'
    IFS= read -r ans || ans=""
    [ -n "$ans" ] || { say ""; return 0; }
    [ "$ans" = a ] || [ "$ans" = A ] && ans=$(seq 1 "$i" | tr '\n' ' ')
    for k in $ans; do
        case "$k" in ''|*[!0-9]*) say "  ⚠ 不认识的编号：$k"; continue;; esac
        p=$(printf '%s\n' "$cands" | sed -n "${k}p" | cut -f3)
        [ -n "$p" ] || { say "  ⚠ 没有第 $k 个"; continue; }
        vt_registered "$p" && continue
        vt_register "$p" && added=$((added + 1))
    done
    say "  新登记 $added 个"
}

show_registered(){ # scope=project 时列出登记表；一个都没有就明说现在什么都不采
    local d p n=0
    say "scope=project：只采下面这些登记过的仓（连同它们的所有 worktree）："
    for d in "$VT_HOME/projects"/*; do
        [ -f "$d" ] || continue
        p=$(head -1 "$d"); n=$((n + 1)); say "  · $p$([ -d "$p" ] || echo '   ⚠ 目录不在了')"
    done
    [ $n -gt 0 ] || say "  ⚠ 还没有登记任何仓，现在什么都不会采。选：$VT_HOME/bin/vibetrail projects pick；或在要采的仓里跑 $VT_HOME/bin/vibetrail projects add"
    say "  （改：vibetrail projects pick / add / remove；全都采：vibetrail init --scope user）"
}

cmd_projects(){
    local sub=${1:-list} d
    case "$sub" in
        list)
            ls "$VT_HOME/projects" 2>/dev/null | grep -q . || { say "（没有登记的项目；scope=$(vt_conf scope project)）"; return 0; }
            for d in "$VT_HOME/projects"/*; do
                [ -f "$d" ] || continue
                local p; p=$(head -1 "$d"); printf '%s%s\n' "$p" "$([ -d "$p" ] || echo '   ⚠ 目录不在了')"
            done ;;
        add) d=${2:-$PWD}; vt_register "$d" && say "✓ 已登记 $(vt_main_checkout "$d")";;
        remove|rm) d=${2:-$PWD}; vt_unregister "$d" && say "✓ 已注销 $(vt_main_checkout "$d")（spool 里已采的不动）" || die "不在 git 仓里：$d";;
        pick) pick_projects;;
        *) die "projects 只认 list / add / remove / pick";;
    esac
}

chunks(){ find "$VT_HOME/spool" -path "$VT_HOME/spool/.rejected" -prune -o -type f -name '*.jsonl' ! -name '.*' -print 2>/dev/null | sort; }

cmd_list(){
    JQ=$(find_jq) || die "没找到 jq"; export JQ
    local n=0 ev=0 bytes=0 f c b
    [ -d "$VT_HOME/spool" ] || { say "（spool 为空：$VT_HOME/spool）"; return 0; }
    printf '%-40s %-38s %-46s %6s %8s\n' "项目" "会话" "块" "条数" "字节"
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        c=$(grep -c . "$f"); b=$(wc -c < "$f" | tr -d ' ')
        printf '%-40s %-38s %-46s %6s %8s\n' "$(basename "$(dirname "$(dirname "$f")")" | cut -c1-40)" "$(basename "$(dirname "$f")")" "$(basename "$f" | cut -c1-46)" "$c" "$b"
        n=$((n + 1)); ev=$((ev + c)); bytes=$((bytes + b))
    done < <(chunks)
    say ""
    say "共 $n 块、$ev 条事件、$bytes 字节，都在 $VT_HOME/spool/ 下，每行一条协议事件，可以直接打开看。"
    say "端点：$( [ -n "$(vt_conf endpoint)" ] && vt_conf endpoint || echo '没配置（push 不发，这些文件就是将来要推的内容）')"
}

# show 用的一行描述：时间、类型、轮、实例，再加这一类事件最要紧的几项；正文截到 100 字
JQ_DESCRIBE='
def clip($n): if type == "string" then (gsub("\\s+"; " ") | if length > $n then .[0:$n] + "…" else . end) else . end;
def short: if type == "string" then .[0:8] else "-" end;
def vcs: if (.payload.vcs | type) == "object" then (.payload.vcs | "\(.branch // "?")@\((.head_sha // "-")[0:7])\(if .dirty == true then " 有改动" else "" end)") else "" end;
def usage: if (.payload.usage | type) == "object" then "tokens \(.payload.usage.total_tokens // "?")" else "" end;
def kn: if type == "number" then (if . >= 1000000 then "\((. / 100000 | floor) / 10)M" elif . >= 1000 then "\((. / 100 | floor) / 10)k" else tostring end) else "-" end;
def secs: if type == "string" then (sub("\\.[0-9]+Z$"; "Z") | fromdate) else null end;
def dur: if type != "number" then "" elif . < 1000 then "\(floor)ms" elif . < 60000 then "\((. / 100 | floor) / 10)s" else "\(. / 60000 | floor)m\((. % 60000) / 1000 | floor)s" end;
def detail:
  if .type == "session.start" then "source=\(.payload.source) model=\(.extensions["claude.model"] // "?") \(.extensions["vibetrail.vcs"] // {} | "\(.branch // "")@\((.head_sha // "")[0:7])")"
  elif .type == "session.end" then "reason=\(.payload.reason)"
  elif .type == "turn.start" then "\(vcs) \(if .payload.model then "model=" + .payload.model else "" end) \(if .provenance.kind == "transcript" then "(transcript 补位)" else "" end)"
  elif .type == "turn.end" then "\(.payload.status.code) \(usage) \(vcs)\(if .commits then " commits=" + ([.commits[].sha[0:7]] | join(",")) else "" end) \(if .extensions["vibetrail.closed_by"] then "关轮:" + .extensions["vibetrail.closed_by"] else "" end)"
  elif .type == "permission.decision" then "\(.payload.decision) by \(.payload.decided_by) \(.payload.tool_name) “\(.payload.reason | clip(80))”"
  elif .type == "tool.request" then "\(.payload.tool_name) \(.payload.input | if type == "object" then (.command // .file_path // .pattern // tojson) else tojson end | clip(100))"
  elif .type == "message.assistant" and .content_state == "omitted" then   # 调用 trace（DESIGN D8）：不带正文，只有元数据
    (.extensions["vibetrail.call"] // {}) as $c
    | "模型 \(.payload.model // "?")  入/缓存/出 \($c.usage.input_tokens | kn)/\($c.usage.cached_input_tokens | kn)/\($c.usage.output_tokens | kn)  \($c.stop_reason // "-")\(if ($c.tool_calls // []) | length > 0 then " → " + ($c.tool_calls | join(",")) else "" end)\(if $c.thinking then "（有 thinking）" else "" end)\(if $c.started_at then "  用时 " + ((((.occurred_at | secs) - ($c.started_at | secs)) * 1000) | dur) else "" end)"
  elif .type == "tool.end" then "\(.payload.tool_name) \({success: "成功", error: "出错", cancelled: "取消"}[.payload.status.code] // .payload.status.code)  \(.payload.duration_ms | dur)"
  elif .type == "message.user" or .type == "message.assistant" then "“\(.payload.text | clip(100))”"
  elif .type == "subagent.start" then "\(.payload.agent_type) 父=\(.parent_agent_instance_id)"
  elif .type == "subagent.end" then "\(.payload.status.code) \(.payload.agent_type // "")"
  elif (.type | startswith("ext.")) then (.payload | del(.tool_input) | tojson | clip(100))
  else "" end;
"\(.occurred_at | sub("\\.[0-9]+Z$"; "Z") | sub("T"; " ") | sub("Z$"; ""))  \(.type | . + (" " * ([22 - length, 1] | max)))turn \(.turn_id | short)  \(.agent_instance_id | if . == "main" then "main    " else .[0:8] end)  \(detail)"'

cmd_show(){
    local sess="" typ="" last=0 raw=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --session) sess=${2:-}; shift 2;;
            --type) typ=${2:-}; shift 2;;
            --last) last=${2:-0}; shift 2;;
            --json) raw=1; shift;;
            *) die "show 不认识的参数：$1";;
        esac
    done
    JQ=$(find_jq) || die "没找到 jq"; export JQ
    local files; files=$(chunks)
    [ -n "$files" ] || { say "（spool 为空：$VT_HOME/spool。装好后在登记过的仓里开一个 Claude Code 会话，说一句话就会有）"; return 0; }
    local all; all=$(printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 cat | "$JQ" -s -c --arg s "$sess" --arg t "$typ" \
        'map(select(($s == "" or (.session_id | startswith($s))) and ($t == "" or (.type | startswith($t))))) | sort_by(.occurred_at, .type)')
    if [ "$last" -gt 0 ] 2>/dev/null; then all=$(printf '%s' "$all" | "$JQ" -c --argjson n "$last" '.[-$n:]'); fi
    if [ $raw = 1 ]; then printf '%s' "$all" | "$JQ" -c '.[]'; return 0; fi
    printf '%s' "$all" | "$JQ" -r 'group_by(.session_id) | sort_by(.[0].occurred_at) | .[] |
        "══ 会话 \(.[0].session_id)  项目 \(.[0].project_id)  \(length) 条",
        (.[] | '"$JQ_DESCRIBE"'), ""'
    say "（按会话、按时间排；原始事件：vibetrail show --json，文件：vibetrail list）"
}

cmd_sync(){ # 与 SessionStart 的补做相同：本仓与所有登记过的仓，落后的 transcript 各补一次；空闲超过 turn_idle_close 的会话把最后一轮也关掉
    JQ=$(find_jq) || die "没找到 jq"; export JQ
    local repo; repo=$(vt_main_checkout "$PWD" 2>/dev/null) || repo=$(head -1 "$VT_HOME/projects"/* 2>/dev/null | head -1)
    [ -n "$repo" ] || die "当前目录不在 git 仓里，也没有登记过的仓"
    local before after
    before=$(chunks | wc -l | tr -d ' ')
    "$JQ" -n -c --arg c "$repo" '{session_id: "vibetrail-sync", cwd: $c, hook_event_name: "CatchUp"}' \
        | VIBETRAIL_FOREGROUND=1 bash "$SELF/vibetrail-hook" CatchUp
    after=$(chunks | wc -l | tr -d ' ')
    say "✓ 补采完：spool 从 $before 块到 $after 块（vibetrail show / list 看结果）"
}

cmd_doctor(){
    local fatal=0 warn=0 a
    ok(){ printf '  ✓ %s\n' "$*"; }
    bad(){ printf '  ✗ %s\n' "$*"; fatal=1; }
    note(){ printf '  ⚠ %s\n' "$*"; warn=1; }
    say "vibetrail doctor（VT_HOME=${VT_HOME}）"
    # 运行时
    if [ -f "$VT_HOME/bin/MANIFEST" ]; then
        local drift=0 miss=0 h f
        while read -r h f; do
            [ -n "$f" ] || continue
            if [ ! -f "$VT_HOME/bin/$f" ]; then miss=$((miss + 1)); continue; fi
            [ "$( (command -v sha256sum >/dev/null 2>&1 && sha256sum "$VT_HOME/bin/$f" || shasum -a 256 "$VT_HOME/bin/$f") | cut -c1-64)" = "$h" ] || drift=$((drift + 1))
        done < "$VT_HOME/bin/MANIFEST"
        if [ $((drift + miss)) -eq 0 ]; then ok "运行时完好（$(sed -n 's/^version=//p' "$VT_HOME/bin/VERSION" 2>/dev/null)，$(grep -c . "$VT_HOME/bin/MANIFEST") 个文件校验通过）"
        else bad "运行时：缺 $miss 个、内容变了 $drift 个——重跑 vibetrail init"; fi
    else bad "运行时不在 $VT_HOME/bin（没装，或被删了）——跑 vibetrail init"; fi
    # jq
    local j; j=$(vt_conf jq "")
    if [ -n "$j" ] && [ -x "$j" ]; then ok "jq：$j"; JQ=$j; else bad "config 里的 jq 不可执行：${j:-没配}——hook 全部静默退出，重跑 vibetrail init"; JQ=$(command -v jq || echo jq); fi
    export JQ
    # settings 条目
    if [ -f "$SETTINGS" ] && "$JQ" -e 'type == "object"' "$SETTINGS" >/dev/null 2>&1; then
        local have; have=$("$JQ" -r '(.hooks // {}) | to_entries[] | select(any(.value[]?.hooks[]?; ((.command? // "") | tostring | contains("vibetrail-hook")))) | .key' "$SETTINGS" | sort | tr '\n' ' ')
        if [ -z "$have" ]; then bad "$SETTINGS 里没有 vibetrail 的 hook 条目——跑 vibetrail init"
        else
            local miss_ev=""; for a in $CORE_EVENTS; do case " $have" in *" $a "*) ;; *) miss_ev="$miss_ev $a";; esac; done
            [ -z "$miss_ev" ] && ok "hook 条目：$have" || bad "hook 条目缺核心事件:$miss_ev"
            local wrong; wrong=$("$JQ" -r '[(.hooks // {})[][]?.hooks[]? | (.command? // "") | tostring | select(contains("vibetrail-hook"))] | .[]' "$SETTINGS" \
                | sed -n "s#^/bin/bash '\(.*\)' [A-Za-z]*\$#\1#p" | sort -u | while IFS= read -r p; do [ -f "$p" ] || printf '%s ' "$p"; done)
            [ -z "$wrong" ] || bad "条目指向的运行时不存在：$wrong"
            # 本机每个 Claude Code 都认识登记的事件吗（不认识会让它把整份 settings 跳过）
            local bins; bins=$(claude_binaries | sort -u)
            if [ -n "$bins" ]; then
                local unk="" kb; while IFS= read -r b; do
                    kb=$(known_events_of "$b")
                    for a in $have; do case "$kb" in *" $a "*) ;; *) unk="$unk ${a}（${b}）";; esac; done
                done <<< "$bins"
                [ -z "$unk" ] && ok "本机 $(printf '%s\n' "$bins" | wc -l | tr -d ' ') 个 Claude Code 都认识这些事件" \
                    || bad "有 Claude Code 不认识登记的事件:${unk}——它会把整份 settings 跳过；重跑 vibetrail init（默认按本机版本登记）"
            fi
        fi
    else bad "读不了 $SETTINGS"; fi
    # scope 与登记
    local scope; scope=$(vt_conf scope project)
    local here; here=$(vt_main_checkout "$PWD" 2>/dev/null) || here=""
    if [ "$scope" = user ]; then ok "scope=user：本机所有目录都采"
    else
        local np; np=$(ls "$VT_HOME/projects" 2>/dev/null | wc -l | tr -d ' ')
        [ "$np" -gt 0 ] && ok "scope=project，登记了 $np 个项目" || note "scope=project 但一个项目都没登记——什么都不会采（vibetrail projects add）"
        if [ -n "$here" ]; then vt_registered "$here" && ok "本仓已登记：$here" || note "本仓没登记：${here}（vibetrail projects add）"; fi
    fi
    # 采集证据
    local nst=0 nch=0 nev=0 oldest=""
    nst=$(ls -d "$VT_HOME/state"/*/ 2>/dev/null | wc -l | tr -d ' ')
    local cf; cf=$(chunks)
    if [ -n "$cf" ]; then
        nch=$(printf '%s\n' "$cf" | wc -l | tr -d ' ')
        nev=$(printf '%s\n' "$cf" | tr '\n' '\0' | xargs -0 cat | grep -c .)
        oldest=$(printf '%s\n' "$cf" | xargs -n1 basename | sort | head -1 | cut -c1-16)
    fi
    ok "采过 $nst 个会话；spool 待发 $nch 块 / $nev 条$( [ -n "$oldest" ] && echo "，最早一块 $oldest" )"
    local rw; rw=$(cat "$VT_HOME/state"/*/*.json 2>/dev/null | "$JQ" -s '[.[] | .rewrites? // 0] | add // 0' 2>/dev/null)
    [ "${rw:-0}" -gt 0 ] 2>/dev/null && note "有 $rw 次 transcript 被重写后从头重读（offset 信任检查，DESIGN §3.3）"
    # 落后：登记的仓里，transcript 比 state 记的长、且 10 分钟没动（活着的会话本来就会领先一点）
    local lag=0 now; now=$(date +%s)
    for a in "$VT_HOME/projects"/*; do
        [ -f "$a" ] || continue
        local repo; repo=$(head -1 "$a"); [ -d "$repo" ] || continue
        while IFS= read -r wt; do
            local dir; dir="$(vt_claude_projects)/$(vt_slug "$wt")"
            for t in "$dir"/*.jsonl; do
                [ -f "$t" ] || continue
                local s c mt; s=$(wc -c < "$t" | tr -d ' '); c=$("$JQ" -r '.consumed_bytes // 0' "$VT_HOME/state/$(basename "$t" .jsonl)/main.json" 2>/dev/null || echo 0)
                mt=$(stat -f %m "$t" 2>/dev/null || stat -c %Y "$t" 2>/dev/null || echo "$now")
                [ "${c:-0}" -lt "$s" ] && [ $((now - mt)) -gt 600 ] && lag=$((lag + 1))
            done
        done < <(git -C "$repo" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
    done
    [ $lag -eq 0 ] && ok "登记的仓里没有落后的 transcript" || note "$lag 份 transcript 没采完（下一次在该仓开会话时 SessionStart 会补做）"
    # 错误日志
    if [ -s "$VT_HOME/logs/errors.log" ]; then
        note "errors.log 有 $(grep -c . "$VT_HOME/logs/errors.log") 条（只记元数据），最近一条：$(tail -1 "$VT_HOME/logs/errors.log")"
    else ok "没有错误日志"; fi
    # 端点
    [ -n "$(vt_conf endpoint)" ] && ok "端点：$(vt_conf endpoint)" || say "  · 端点没配置：只落本机 spool、不发（push 还没做，DESIGN §4）"
    say ""
    if [ $fatal -ne 0 ]; then say "✗ 有致命项，采集当前不工作"; return 1
    elif [ $warn -ne 0 ]; then say "⚠ 能用，有告警"; else say "✓ 采集工作正常"; fi
}

case "${1:-}" in
    init) shift; cmd_init "$@";;
    uninstall) shift; cmd_uninstall "$@";;
    projects) shift; cmd_projects "$@";;
    list) shift; cmd_list "$@";;
    show) shift; cmd_show "$@";;
    doctor) shift; cmd_doctor "$@";;
    sync) shift; cmd_sync "$@";;
    version|--version|-v) say "vibetrail $VT_RUNTIME_VERSION"; [ -f "$SELF/VERSION" ] && cat "$SELF/VERSION";;
    ''|-h|--help|help) usage;;
    *) usage; exit 1;;
esac
