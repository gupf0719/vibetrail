{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csoss:paas-coding:collection-batch:1.0",
  "title": "PAAS Coding Hook batch 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "client", "events"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "batch_id": { "$ref": "#/$defs/uuid" },
    "client": { "$ref": "#/$defs/client" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "eventType": {
      "anyOf": [
        {
          "enum": [
            "session.start",
            "session.end",
            "turn.start",
            "turn.end",
            "message.user",
            "message.assistant",
            "tool.request",
            "tool.start",
            "tool.end",
            "permission.request",
            "permission.decision",
            "subagent.start",
            "subagent.end"
          ]
        },
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^ext\\.[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$"
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f])[^/]+(?:/[^/]+)*$"
    },
    "sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "evidence": {
      "anyOf": [
        { "enum": ["tool_argument", "tool_result", "before_after", "hook", "transcript", "filesystem"] },
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^ext\\.[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$"
        }
      ]
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "device_id", "policy_version"],
      "properties": {
        "name": { "const": "paas-coding-hook" },
        "version": { "$ref": "#/$defs/id" },
        "device_id": { "$ref": "#/$defs/uuid" },
        "policy_version": { "$ref": "#/$defs/id" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/code" },
        "version": { "$ref": "#/$defs/id" },
        "surface": { "$ref": "#/$defs/code" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/code" },
        "source_event": { "$ref": "#/$defs/id" },
        "source_event_id": { "$ref": "#/$defs/id" },
        "rule_version": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["transcript", "inferred"] }
            },
            "required": ["kind"]
          },
          "then": { "required": ["rule_version"] }
        }
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category"],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "category": { "$ref": "#/$defs/code" },
        "detail": { "type": "string", "maxLength": 4096 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "vcsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "branch": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "head_sha": { "$ref": "#/$defs/sha" },
        "dirty": { "type": "boolean" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "evidence"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "operation": {
          "anyOf": [
            { "enum": ["target", "read", "create", "modify", "delete", "rename"] },
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^ext\\.[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$"
            }
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "old_path": { "$ref": "#/$defs/path" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "rename" } },
            "required": ["operation"]
          },
          "then": { "required": ["old_path"] },
          "else": { "not": { "required": ["old_path"] } }
        },
        {
          "if": {
            "properties": { "evidence": { "const": "tool_argument" } },
            "required": ["evidence"]
          },
          "then": {
            "properties": { "operation": { "enum": ["target", "read"] } }
          }
        }
      ]
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "relation", "evidence"],
      "properties": {
        "sha": { "$ref": "#/$defs/sha" },
        "relation": { "const": "observed" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
      },
      "additionalProperties": true
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "data"],
      "properties": {
        "event_name": { "$ref": "#/$defs/id" },
        "data": {}
      }
    },
    "sessionStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "capabilities"],
      "properties": {
        "source": { "$ref": "#/$defs/code" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/code" },
          "uniqueItems": true
        }
      }
    },
    "sessionEndPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "status"],
      "properties": {
        "reason": { "$ref": "#/$defs/code" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "turnStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/id" },
        "vcs": { "$ref": "#/$defs/vcsSnapshot" }
      }
    },
    "turnEndPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "model": { "$ref": "#/$defs/id" },
        "usage": { "$ref": "#/$defs/usage" },
        "vcs": { "$ref": "#/$defs/vcsSnapshot" }
      }
    },
    "messagePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_type"],
      "properties": {
        "text": { "type": "string" },
        "author_type": { "$ref": "#/$defs/code" },
        "delivery": { "$ref": "#/$defs/code" },
        "model": { "$ref": "#/$defs/id" }
      }
    },
    "toolRequestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "call_id"],
      "properties": {
        "tool_name": { "$ref": "#/$defs/id" },
        "raw_tool_name": { "$ref": "#/$defs/id" },
        "call_id": { "$ref": "#/$defs/id" },
        "input": {}
      }
    },
    "toolStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "call_id"],
      "properties": {
        "tool_name": { "$ref": "#/$defs/id" },
        "raw_tool_name": { "$ref": "#/$defs/id" },
        "call_id": { "$ref": "#/$defs/id" },
        "input": {}
      }
    },
    "toolEndPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "call_id", "status"],
      "properties": {
        "tool_name": { "$ref": "#/$defs/id" },
        "raw_tool_name": { "$ref": "#/$defs/id" },
        "call_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "output": {},
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "permissionRequestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission_id", "tool_name"],
      "properties": {
        "permission_id": { "$ref": "#/$defs/id" },
        "tool_name": { "$ref": "#/$defs/id" },
        "call_id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "maxLength": 4096 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/code" },
          "uniqueItems": true
        }
      }
    },
    "permissionDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission_id", "tool_name", "decision", "decided_by"],
      "properties": {
        "permission_id": { "$ref": "#/$defs/id" },
        "tool_name": { "$ref": "#/$defs/id" },
        "call_id": { "$ref": "#/$defs/id" },
        "decision": { "$ref": "#/$defs/code" },
        "decided_by": { "$ref": "#/$defs/code" },
        "reason": { "type": "string", "maxLength": 4096 },
        "rule_id": { "$ref": "#/$defs/id" },
        "rule_version": { "$ref": "#/$defs/id" }
      }
    },
    "subagentStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_type"],
      "properties": {
        "agent_type": { "$ref": "#/$defs/id" },
        "task": { "type": "string" }
      }
    },
    "subagentEndPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "agent_type": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "last_message": { "type": "string" }
      }
    },
    "extensionPayload": {
      "type": "object"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "occurred_at",
        "type",
        "agent",
        "project_id",
        "workspace_id",
        "session_id",
        "agent_instance_id",
        "provenance",
        "payload"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/uuid" },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "type": { "$ref": "#/$defs/eventType" },
        "agent": { "$ref": "#/$defs/agent" },
        "project_id": { "$ref": "#/$defs/id" },
        "workspace_id": { "$ref": "#/$defs/id" },
        "session_id": { "$ref": "#/$defs/id" },
        "session_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "turn_id": { "$ref": "#/$defs/id" },
        "agent_instance_id": { "$ref": "#/$defs/id" },
        "parent_agent_instance_id": { "$ref": "#/$defs/id" },
        "parent_session_id": { "$ref": "#/$defs/id" },
        "parent_call_id": { "$ref": "#/$defs/id" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "payload": { "type": "object" },
        "files": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/file" }
        },
        "commits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/commit" }
        },
        "content_state": { "enum": ["included", "omitted"] },
        "raw": { "$ref": "#/$defs/raw" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "turn.start",
                  "turn.end",
                  "message.user",
                  "message.assistant",
                  "tool.request",
                  "tool.start",
                  "tool.end",
                  "permission.request",
                  "permission.decision",
                  "subagent.start",
                  "subagent.end"
                ]
              }
            }
          },
          "then": { "required": ["turn_id"] }
        },
        {
          "if": { "properties": { "type": { "const": "session.start" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/sessionStartPayload" } } }
        },
        {
          "if": { "properties": { "type": { "const": "session.end" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/sessionEndPayload" } } }
        },
        {
          "if": { "properties": { "type": { "const": "turn.start" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/turnStartPayload" } } }
        },
        {
          "if": { "properties": { "type": { "const": "turn.end" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/turnEndPayload" } } }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["message.user", "message.assistant"] } }
          },
          "then": { "properties": { "payload": { "$ref": "#/$defs/messagePayload" } } }
        },
        {
          "if": { "properties": { "type": { "const": "tool.request" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/toolRequestPayload" } } }
        },
        {
          "if": { "properties": { "type": { "const": "tool.start" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/toolStartPayload" } } }
        },
        {
          "if": { "properties": { "type": { "const": "tool.end" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/toolEndPayload" } } }
        },
        {
          "if": { "properties": { "type": { "const": "permission.request" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/permissionRequestPayload" } } }
        },
        {
          "if": { "properties": { "type": { "const": "permission.decision" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/permissionDecisionPayload" } } }
        },
        {
          "if": { "properties": { "type": { "const": "subagent.start" } } },
          "then": {
            "required": ["parent_agent_instance_id"],
            "properties": { "payload": { "$ref": "#/$defs/subagentStartPayload" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "subagent.end" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/subagentEndPayload" } } }
        },
        {
          "if": { "required": ["commits"] },
          "then": { "properties": { "type": { "const": "turn.end" } } }
        },
        {
          "if": { "properties": { "type": { "pattern": "^ext\\." } } },
          "then": {
            "properties": {
              "provenance": { "required": ["source_event"] },
              "payload": { "$ref": "#/$defs/extensionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["message.user", "message.assistant"] } },
            "not": {
              "properties": { "content_state": { "const": "omitted" } },
              "required": ["content_state"]
            }
          },
          "then": { "properties": { "payload": { "required": ["text"] } } }
        },
        {
          "if": {
            "properties": { "content_state": { "const": "omitted" } },
            "required": ["content_state"]
          },
          "then": {
            "not": { "required": ["raw"] },
            "properties": {
              "payload": {
                "not": {
                  "anyOf": [
                    { "required": ["text"] },
                    { "required": ["input"] },
                    { "required": ["output"] },
                    { "required": ["task"] },
                    { "required": ["last_message"] }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
