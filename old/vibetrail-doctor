#!/bin/bash
# 回答一个问题：这个仓现在的留痕，是不是真的在工作？
# 存在的理由：所有失效形态都是静默的——漏装、被别的 hook 顶掉、上游改字段名，
# 都不会报错，只是从此不再留痕。
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" 2>/dev/null || { echo "✗ 不在 git 仓库里"; exit 1; }
SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
fail=0; warn=0

HOOKS=$(git rev-parse --git-path hooks)
DST="$HOOKS/prepare-commit-msg"
printf '%-34s' "hook 已安装"
if [ -x "$DST" ]; then echo "✓ $DST"; else echo "✗ 缺失或不可执行 —— 跑 vibetrail-install"; fail=1; fi

printf '%-34s' "hook 与仓内版本一致"
if [ -f "$DST" ] && cmp -s "$SELF_DIR/prepare-commit-msg" "$DST"; then echo "✓"
else echo "✗ 内容漂了 —— 重跑 vibetrail-install"; fail=1; fi

printf '%-34s' "core.hooksPath 被谁占用"
HPO=$(git config --show-origin core.hooksPath 2>/dev/null | head -1 | cut -f1 || true)
if [ -z "$HPO" ]; then echo "— 未设（git 默认 .git/hooks）"
else echo "ℹ 被 ${HPO#file:} 设定（已尊重，装进其指向的目录）"; fi

printf '%-34s' "会话变量可见"
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then echo "✓ ${CLAUDE_CODE_SESSION_ID:0:8}…"
else echo "— 当前 shell 不在 agent 会话里（人工提交本就不该留痕）"; fi

printf '%-34s' ".gitattributes merge=union"
# 只认 audits/ 那条。旧版 install 写的是 `**/*.jsonl`，连 sessions/ 一起 union 合并——那是整份
# 重生成的投影，union 会静默合出两条 end；而这里以前只 grep 'merge=union'，宽窄都算 ✓（T16）。
BROAD='^[[:space:]]*\.claude/trace/\*\*/\*\.jsonl[[:space:]]+merge=union[[:space:]]*$'
NARROW='^[[:space:]]*\.claude/trace/audits/\*\.jsonl[[:space:]]+merge=union[[:space:]]*$'
if grep -qE "$BROAD" .gitattributes 2>/dev/null; then
    echo "⚠ 仍是旧的宽规则 **/*.jsonl —— sessions/ 会被 union 合并（静默合出两条 end），重跑 vibetrail-install"; warn=1
elif grep -qE "$NARROW" .gitattributes 2>/dev/null; then echo "✓ 只对 audits/ 生效"
else echo "⚠ audits/ 缺 merge=union —— 同分支并发追加时会要人工解冲突"; warn=1; fi

printf '%-34s' "vendored 运行时完好"
VD=.claude/vibetrail
sha(){ if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}';
       else shasum -a 256 "$1" | awk '{print $1}'; fi; }
if [ ! -d "$VD" ]; then
    # 缺整个运行时是致命的：闸门依赖它，而这条以前只打印一行、既不置 warn 也不置 fail，
    # 于是整目录缺失时 doctor 仍报「留痕工作正常」。
    echo "✗ 目录缺失 —— 闸门无法工作，跑 vibetrail-install"; fail=1
elif [ ! -f "$VD/MANIFEST" ]; then
    echo "✗ 缺 MANIFEST —— 无法验证完好性，重跑 vibetrail-install"; fail=1
else
    drift=0; miss=0; mode=0
    while read -r want x f; do
        [ -n "$f" ] || continue
        if [ ! -f "$VD/$f" ]; then miss=$((miss+1)); continue; fi
        [ "$(sha "$VD/$f")" = "$want" ] || drift=$((drift+1))
        if [ "$x" = x ] && [ ! -x "$VD/$f" ]; then mode=$((mode+1)); fi
    done < "$VD/MANIFEST"
    if [ $((drift+miss+mode)) -eq 0 ]; then echo "✓ $(wc -l < "$VD/MANIFEST" | tr -d ' ') 个文件校验通过"
    else
        echo "⚠ 内容变了 $drift / 缺失 $miss / 丢可执行位 $mode —— 重跑 vibetrail-install"; warn=1
    fi
fi

N=${1:-20}
printf '%-34s' "最近 $N 个 commit 的归属"
have=$(git log -"$N" --format='%(trailers:key=Claude-Session,valueonly,separator=)' 2>/dev/null | grep -c . || true)
echo "$have / $N 带 Claude-Session"

echo
if [ $fail -ne 0 ]; then echo "✗ 有致命项，留痕当前不工作"; exit 1
elif [ $warn -ne 0 ]; then echo "⚠ 可用，但有告警"; exit 0
else echo "✓ 留痕工作正常"; fi
